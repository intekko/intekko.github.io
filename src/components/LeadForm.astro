---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { courses, url } from '../lib/util';
interface Props { id: string; preset?: string; title?: string; compact?: boolean }
const { id, preset = '', title, compact = false } = Astro.props;
const popular = [
  ['rospa-defensive-driving', 'RoSPA вождение'], ['winter-driving', 'Зимнее вождение'], ['iosh-managing-safely', 'IOSH Managing Safely'],
  ['prombez', 'ПромБез'], ['ptm', 'ПТМ'], ['biot', 'БиОТ'], ['first-aid', 'Первая помощь'], ['hazop-hazid', 'HAZOP & HAZID'],
  ['safety-culture', 'Культура безопасности'], ['consulting', 'Консалтинг'],
];
const presetInPopular = popular.some(([s]) => s === preset);
const presetCourse = !presetInPopular && preset ? courses.find((c) => c.slug === preset) : null;
---
<form class="form lead-form" id={id} novalidate data-lead-form data-endpoint={site.leadEndpoint} data-thanks={url('/thanks/')}>
  {title && <h3>{title}</h3>}
  <div class="form-context" data-context aria-live="polite"></div>
  <div class="form__row">
    <div class="field"><label for={`${id}-name`}>Имя <span class="req">*</span></label><input id={`${id}-name`} name="name" autocomplete="name" required minlength="2" maxlength="80" /><span class="field__err" aria-live="polite"></span></div>
    <div class="field"><label for={`${id}-phone`}>Телефон <span class="req">*</span></label><input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" required data-phone /><span class="field__err" aria-live="polite"></span></div>
  </div>
  {!compact && (
    <div class="form__row">
      <div class="field"><label for={`${id}-company`}>Компания</label><input id={`${id}-company`} name="company" autocomplete="organization" maxlength="120" /></div>
      <div class="field"><label for={`${id}-email`}>Email</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="120" /><span class="field__err" aria-live="polite"></span></div>
    </div>
  )}
  <fieldset class="field" style="border:0;padding:0;margin:0">
    <legend class="label" style="margin-bottom:6px;font-weight:600;font-size:14px">Курс или услуга</legend>
    <div class="chips-select" data-chips>
      {presetCourse && <label><input type="checkbox" name="courses" value={presetCourse.slug} checked /><span>{presetCourse.shortTitle}</span></label>}
      {popular.map(([s, t]) => <label><input type="checkbox" name="courses" value={s} checked={s === preset} /><span>{t}</span></label>)}
    </div>
    <input class="sr-only-focusable" list={`${id}-list`} placeholder="Найти другой курс в каталоге…" data-course-search aria-label="Найти курс в каталоге" style="margin-top:8px;font:inherit;font-size:15px;padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;width:100%" />
    <datalist id={`${id}-list`}>{courses.filter((c) => c.status === 'active').map((c) => <option value={c.shortTitle} data-slug={c.slug} />)}</datalist>
  </fieldset>
  {!compact && (
    <div class="form__row">
      <div class="field"><label for={`${id}-people`}>Количество участников</label>
        <select id={`${id}-people`} name="participants"><option value="">Не выбрано</option><option>1</option><option>2–5</option><option>6–15</option><option>16+</option></select></div>
      <div class="field"><label for={`${id}-format`}>Предпочтительный формат</label>
        <select id={`${id}-format`} name="format"><option value="">Не выбрано</option><option>Очно в центре</option><option>Выезд к нам</option><option>Онлайн</option><option>E-learning</option></select></div>
    </div>
  )}
  <div class="field"><label for={`${id}-msg`}>Сообщение</label><textarea id={`${id}-msg`} name="message" maxlength="1000" rows={compact ? 2 : 3} placeholder="Например: 12 водителей, Атырау, декабрь"></textarea></div>
  <input type="hidden" name="schedule_id" />
  <input type="hidden" name="course_slug" value={preset} />
  <div class="hp" aria-hidden="true"><label>Не заполняйте это поле<input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <label class="check"><input type="checkbox" name="consent" required /> <span>Я согласен(на) на обработку персональных данных в соответствии с <a href={url('/privacy/')} target="_blank">политикой</a> (Закон РК «О персональных данных и их защите»)</span></label>
  <span class="field__err" data-consent-err aria-live="polite"></span>
  <button class="btn btn--primary btn--block" type="submit"><Icon name="send" size={18} /> Отправить заявку</button>
  <p class="note" style="margin:0">Ответим в течение рабочего дня. Или напишите нам в <a href={`https://wa.me/${site.phones[0].e164.slice(1)}`} target="_blank" rel="noopener" data-goal="click_whatsapp">WhatsApp</a>.</p>
</form>
