---
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
---
<div class="modal" id="lead-modal" role="dialog" aria-modal="true" aria-labelledby="lead-modal-title" hidden>
  <div class="modal__box">
    <button class="modal__close" type="button" aria-label="Закрыть" data-close><Icon name="close" /></button>
    <span class="eyebrow">Заявка на обучение</span>
    <h2 id="lead-modal-title" style="font-size:26px">Оставьте заявку — подберём программу и даты</h2>
    <LeadForm id="modal-form" />
  </div>
</div>
